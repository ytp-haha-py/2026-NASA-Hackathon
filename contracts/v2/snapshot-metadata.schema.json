{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "coverage": {
      "additionalProperties": true,
      "title": "Coverage",
      "type": "object"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "data_version": {
      "title": "Data Version",
      "type": "string"
    },
    "manifests": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Manifests",
      "type": "array"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "schema_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Schema Versions",
      "type": "object"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Commit"
    }
  },
  "required": [
    "snapshot_id",
    "created_at",
    "schema_versions",
    "manifests",
    "artifacts",
    "data_version"
  ],
  "title": "SnapshotMetadataV2",
  "type": "object"
}
