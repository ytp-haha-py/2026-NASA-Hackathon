{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bounded": {
      "default": true,
      "title": "Bounded",
      "type": "boolean"
    },
    "command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Command"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "input_asset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Input Asset Ids",
      "type": "array"
    },
    "input_checksums": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Checksums",
      "type": "object"
    },
    "limits": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          }
        ]
      },
      "title": "Limits",
      "type": "object"
    },
    "method_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Method Versions",
      "type": "object"
    },
    "output_checksum": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Checksum"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "no_coverage",
        "dry_run"
      ],
      "title": "Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "window_selection_rule": {
      "title": "Window Selection Rule",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "input_asset_ids",
    "window_selection_rule",
    "method_versions",
    "status"
  ],
  "title": "ProcessingRunV2",
  "type": "object"
}
