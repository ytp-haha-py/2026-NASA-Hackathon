# Backend configuration (all optional for the local MVP)
ANALOG_DATABASE_URL=sqlite+pysqlite:///./var/analog.db
ANALOG_CORS_ORIGINS=http://localhost:5173
ANALOG_SEED_INCLUDE_SYNTHETIC=false
# Directory containing pipeline handoff manifests (relative to repo root or absolute)
ANALOG_MANIFEST_DIR=pipelines/earth/manifests
ANALOG_MANIFEST_DIR_CONTEXT=pipelines/worldcover/manifests
ANALOG_MANIFEST_DIR_PLANETARY=pipelines/planetary/manifests
# On-demand AOI worker (local MVP queue)
ANALOG_AOI_INLINE=false
ANALOG_AOI_WORKERS=2
# Durable runtime manifests for user-created AOIs (not the Git-pinned baseline)
ANALOG_AOI_RUNTIME_DIR=var/aoi-catalog
# Web development proxy target
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional team artifact storage (S3-compatible; Cloudflare R2 recommended).
# Leave unset for the offline/local object store. Never commit real credentials.
ANALOG_OBJECT_STORE_BACKEND=local
ANALOG_OBJECT_STORE_ENDPOINT=
ANALOG_OBJECT_STORE_BUCKET=
ANALOG_OBJECT_STORE_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional data directories; relative paths resolve from the repository root.
# Explicit importer --cache-dir / --source / --output options take precedence.
ANALOG_RAW_DIR=data/raw
ANALOG_CACHE_DIR=data/cache
ANALOG_PROCESSED_DIR=data/processed
ANALOG_TMP_DIR=data/tmp
# For external disks, set TMPDIR and CPL_TMPDIR to the same absolute temp path.
# uv reads its cache setting before Python starts: use uv run --env-file .env ...
# UV_CACHE_DIR=<cache-dir>/uv
# npm_config_cache=<cache-dir>/npm
